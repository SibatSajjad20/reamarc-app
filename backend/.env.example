# Application Settings
ENVIRONMENT=development
TIMEZONE=Asia/Karachi
SECRET_KEY=change-this-super-secret-key-in-production
INTERNAL_JOB_SECRET=change-this-internal-job-secret

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=copywriting_agent

# LLM API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_LLM_PROVIDER=gemini
FALLBACK_LLM_PROVIDER=groq

# Social Publishing Credentials (Facebook Graph API V1)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
ENCRYPTION_KEY=32_byte_fernet_key_base64_encoded
