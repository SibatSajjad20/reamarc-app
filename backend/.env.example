# Application Settings
ENVIRONMENT=development
TIMEZONE=Asia/Karachi
# SECRET_KEY must be at least 32 characters
SECRET_KEY=change-this-super-secret-key-in-production-min-32
INTERNAL_JOB_SECRET=change-this-internal-job-secret
COOKIE_SECURE=false
IS_PRODUCTION=false

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=copywriting_agent

# CORS — in production set ENVIRONMENT=production and list exact frontend origins:
# ALLOWED_ORIGINS=https://your-app.vercel.app
# APP_FRONTEND_URL=https://your-app.vercel.app
ALLOWED_ORIGINS=
APP_FRONTEND_URL=http://localhost:5173

# Office geofence / attendance check-in (set in production — never commit real WAN IP)
OFFICE_PUBLIC_IPS=
OFFICE_LATITUDE=33.52062764084008
OFFICE_LONGITUDE=73.09183393441234
OFFICE_MAP_URL=
GEOFENCE_RADIUS_METERS=500
MAX_GPS_ACCURACY_METERS=500

# Email sender (required for Brevo / SMTP dispatch)
SMTP_FROM_EMAIL=noreply@your-domain.com
SMTP_FROM_NAME=Reamarc Workspace
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_LLM_PROVIDER=openrouter
FALLBACK_LLM_PROVIDER=groq

# Social Publishing Credentials (Facebook Graph API V1)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Dedicated Fernet key for ad tokens (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Independent of SECRET_KEY. If unset, Fernet is derived from SECRET_KEY (legacy).
ENCRYPTION_KEY=
